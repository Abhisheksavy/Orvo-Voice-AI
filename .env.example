# Copy this to .env and fill in values
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://mongo:27017/orvo-voice-ai
CORS_ORIGIN=http://localhost:3000

# Sarvam AI  →  https://app.sarvam.ai  →  API Keys
SARVAM_API_KEY=

# Google AI Studio (for Gemma)  →  https://aistudio.google.com  →  Get API Key
GEMMA_API_KEY=
GEMMA_MODEL=gemma-3-12b-it

MAX_AUDIO_SIZE_MB=10
