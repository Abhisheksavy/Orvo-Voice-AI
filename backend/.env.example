PORT=5000
MONGO_URI=mongodb://mongo:27017/orvo-voice-ai
NODE_ENV=development

# Sarvam AI — https://api.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key

# Google AI Studio (Gemma via Gemini API) — https://aistudio.google.com
GEMMA_API_KEY=your_google_ai_studio_key
GEMMA_MODEL=gemma-3-12b-it

# Audio
MAX_AUDIO_SIZE_MB=10
